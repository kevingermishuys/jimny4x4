<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
  Registers the Jimny snippets in the website editor's "Insert Blocks"
  panel. Verified against the actual Odoo 19.0 source for
  website.snippets before writing this: the panel is built from custom
  <snippets> elements (not plain divs), with a dedicated
  installed_snippets_hook anchor inside snippet_groups meant exactly
  for third-party modules adding their own category tab, and
  individual blocks declared as <t t-snippet="..." group="..."/>
  direct children of snippet_structure (no per-block t-thumbnail in
  core Odoo's own entries, so we follow that convention too).
-->
<template id="snippets" inherit_id="website.snippets" name="Jimny Theme Snippets">
    <xpath expr="//snippets[@id='snippet_groups']/t[@id='installed_snippets_hook']" position="before">
        <t snippet-group="jimny" t-snippet="website.s_snippet_group" string="Jimny"
           t-thumbnail="/jimny_snippets/static/description/icon.png"/>
    </xpath>
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="jimny_snippets.s_jimny_hero" string="Hero" group="jimny">
            <keywords>jimny, hero, video, 4x4, rental, banner</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_feature" string="Feature" group="jimny">
            <keywords>jimny, feature, photo, editorial</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_steps" string="Steps" group="jimny">
            <keywords>jimny, steps, how it works, process</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_fleet_teaser" string="Fleet Teaser" group="jimny">
            <keywords>jimny, fleet, vehicles, cars, teaser</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_fleet_gallery" string="Fleet Gallery" group="jimny">
            <keywords>jimny, fleet, vehicles, cars, gallery, carousel</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_pricing" string="Pricing" group="jimny">
            <keywords>jimny, pricing, rates, packages, table</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_addons" string="Add-ons" group="jimny">
            <keywords>jimny, addons, extras, gear</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_testimonials" string="Testimonials" group="jimny">
            <keywords>jimny, testimonials, reviews, quotes</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_page_head" string="Page Head" group="jimny">
            <keywords>jimny, page header, banner, title</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_routes" string="Route Ideas" group="jimny">
            <keywords>jimny, routes, trips, destinations</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_events" string="Events" group="jimny">
            <keywords>jimny, events, meetups</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_shop_categories" string="Shop Categories" group="jimny">
            <keywords>jimny, shop, categories, products</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_booking_form" string="Booking Form" group="jimny">
            <keywords>jimny, booking, reservation, form</keywords>
        </t>
        <t t-snippet="jimny_snippets.s_jimny_contact" string="Contact" group="jimny">
            <keywords>jimny, contact, form, enquiry</keywords>
        </t>
    </xpath>
</template>

</odoo>
