<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
  Light-touch branding for the two page types this module never
  templates directly: the login/signup screen and the payment-method
  selection step. Verified against the actual Odoo 19.0 source for
  web.login_layout, web.login and payment.form before writing these
  xpaths, so they match real element ids/classes rather than guesses.

  These only ADD a small heading and a couple of classes — no field,
  button, or auth/payment logic is touched, so uninstalling this
  module cleanly reverts both pages to Odoo's stock look with zero
  functional impact either way.
-->

<template id="login_layout_branding" inherit_id="web.login_layout" name="Jimny Login Background">
    <xpath expr="//t[@t-set='body_classname']" position="attributes">
        <attribute name="t-value">'bg-100 o_jimny_login_bg'</attribute>
    </xpath>
</template>

<template id="login_branding" inherit_id="web.login" name="Jimny Login Heading">
    <xpath expr="//div[hasclass('field-login')]" position="before">
        <div class="text-center mb-4 o_jimny_login_kicker">
            <div class="kicker">Jimny 4x4 Rentals</div>
            <h1 class="h3 mb-0">Welcome back</h1>
        </div>
    </xpath>
</template>

<template id="payment_form_branding" inherit_id="payment.form" name="Jimny Payment Heading">
    <xpath expr="//div[@id='o_payment_form_options']" position="before">
        <div class="o_jimny_payment_kicker mb-2">
            <div class="kicker">Secure Checkout</div>
            <h2 class="h4 mb-0">Choose how you'd like to pay</h2>
        </div>
    </xpath>
</template>

</odoo>
