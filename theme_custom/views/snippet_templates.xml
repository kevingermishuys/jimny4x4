<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
  Jimny 4x4 Rentals building blocks.

  Every section root carries o_cc + o_ccN so its background/text pair
  comes from the website's configured Color Presets (Website >
  Configuration > Theme) rather than a hardcoded color, and can be
  changed per-instance from the block's "Colors" option in the editor.
  The o_ccN picked below is only a sensible default rhythm (dark/light
  alternating, matching the approved design) — for it to reproduce the
  exact approved palette, set Color Presets 1-5 to:
    1 dark ink #14170F / 2 forest #1F4A0B / 3 cream #F5E7CC /
    4 parchment #EDE6D3 / 5 sand accent #FF954D
  Layout uses Bootstrap 5's grid (container/row/col-lg-*) and buttons
  are plain .btn so they pick up the section's color combo automatically.
-->

<template id="s_jimny_hero" name="Jimny - Hero">
  <section class="s_jimny_hero o_cc o_cc1 position-relative overflow-hidden d-flex align-items-center min-vh-100" data-snippet="s_jimny_hero" data-name="Jimny Hero">
    <video class="hero-video position-absolute top-0 start-0 w-100 h-100" autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" preload="auto">
      <source src="/theme_custom/static/src/img/hero-video.mp4" type="video/mp4"/>
    </video>
    <div class="container position-relative">
      <div class="row">
        <div class="col-lg-7 hero-copy">
          <div class="kicker">Permit No. J4X4 — Cape Town, ZA</div>
          <h1>Explore.<br/>Unwind.<br/><em>Discover.</em></h1>
          <p class="lead">Rent a nimble Suzuki Jimny 4X4 and embark on the journey you've been craving! Rugged trails, hidden spots and pure freedom.</p>
          <div class="price-line">Starting from as little as <b>R1,300</b> / day</div>
          <div class="d-flex flex-wrap gap-3 mb-4">
            <a class="btn btn-primary" href="/book">Book Your Adventure</a>
            <a class="btn btn-outline-primary" href="/shop">Shop Gear</a>
          </div>
          <div class="hero-trust d-flex flex-wrap border-top pt-3">
            <div>24/7 GPS Tracking</div>
            <div>Fully Equipped 4X4s</div>
            <div>Local Cape Town Team</div>
            <div>Roadside Assistance</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</template>

